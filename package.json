{
  "name": "punch",
  "version": "0.1.0",
  "description": "A simple CLI time tracker",
  "type": "module",
  "bin": {
    "punch": "./src/main.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "preview": "bun run scripts/preview.ts"
  },
  "keywords": [
    "tui",
    "time-tracking",
    "ink",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
